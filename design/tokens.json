{
  "color": {
    "bg": {
      "base":    { "value": "#0c0c0c", "$type": "color", "comment": "Page / terminal background" },
      "panel":   { "value": "#111111", "$type": "color", "comment": "Header, footer, side panels" },
      "sel":     { "value": "#1a1a1a", "$type": "color", "comment": "Selected row / focused cell" }
    },
    "border": {
      "default": { "value": "#272727", "$type": "color", "comment": "Panel borders, dividers" },
      "bright":  { "value": "#3c3c3c", "$type": "color", "comment": "Keybinding outlines, hover borders" },
      "wire":    { "value": "#383838", "$type": "color", "comment": "Box-drawing connectors, structural chars" }
    },
    "text": {
      "bright":  { "value": "#ebebeb", "$type": "color", "comment": "Primary emphasis — role names, values" },
      "default": { "value": "#cacaca", "$type": "color", "comment": "Body text" },
      "muted":   { "value": "#8c8c8c", "$type": "color", "comment": "Labels, captions — minimum readable level" }
    },
    "green": {
      "fg":  { "value": "#3fb950", "$type": "color", "comment": "LOAD-BEARING verdict, positive delta, pass ✓" },
      "bg":  { "value": "#0d2018", "$type": "color", "comment": "LOAD-BEARING row background" }
    },
    "red": {
      "fg":  { "value": "#f85149", "$type": "color", "comment": "WITNESS verdict, fail ✗, harmful delta" },
      "bg":  { "value": "#2d0e0e", "$type": "color", "comment": "WITNESS row background" },
      "dim": { "value": "#581414", "$type": "color", "comment": "Struck-through DAG boxes, pruned connectors" }
    },
    "amber": {
      "fg":  { "value": "#d29922", "$type": "color", "comment": "UNCERTAIN verdict, keybinding labels, warnings" },
      "hi":  { "value": "#fbbf24", "$type": "color", "comment": "Highlighted tool-call fields in Case Inspector" },
      "bg":  { "value": "#231908", "$type": "color", "comment": "UNCERTAIN row background" }
    },
    "cyan": {
      "fg":  { "value": "#58a6ff", "$type": "color", "comment": "OCCAM brand, CURRENT badge, streaming cursor" },
      "bg":  { "value": "#0d1e2d", "$type": "color", "comment": "Cyan badge fill" }
    },
    "purple": {
      "fg":  { "value": "#bc8cff", "$type": "color", "comment": "rel³ metric, context_iso justification tag" }
    }
  },

  "verdict": {
    "load-bearing": {
      "label":   { "value": "● LOAD-BEARING", "$type": "string" },
      "color":   { "value": "{color.green.fg}",  "$type": "color" },
      "bg":      { "value": "{color.green.bg}",  "$type": "color" }
    },
    "witness": {
      "label":   { "value": "✗ WITNESS",       "$type": "string" },
      "color":   { "value": "{color.red.fg}",   "$type": "color" },
      "bg":      { "value": "{color.red.bg}",   "$type": "color" },
      "weight":  { "value": "700",              "$type": "fontWeight" }
    },
    "uncertain": {
      "label":   { "value": "? UNCERTAIN",     "$type": "string" },
      "color":   { "value": "{color.amber.fg}", "$type": "color" },
      "bg":      { "value": "{color.amber.bg}", "$type": "color" }
    },
    "harmful": {
      "label":   { "value": "⚠ HARMFUL",       "$type": "string" },
      "color":   { "value": "#ff3333",          "$type": "color" },
      "bg":      { "value": "#1a0000",          "$type": "color" }
    }
  },

  "justification": {
    "parallel":     { "color": { "value": "{color.cyan.fg}",   "$type": "color" } },
    "context_iso":  { "color": { "value": "{color.purple.fg}", "$type": "color" } },
    "verification": { "color": { "value": "{color.amber.fg}",  "$type": "color" } },
    "control":      { "color": { "value": "{color.green.fg}",  "$type": "color" } }
  },

  "lesson": {
    "badge": {
      "tool": { "color": { "value": "{color.cyan.fg}",  "$type": "color" } },
      "rule": { "color": { "value": "{color.amber.fg}", "$type": "color" } }
    }
  },

  "typography": {
    "fontFamily": {
      "mono": { "value": "'JetBrains Mono', 'Cascadia Code', monospace", "$type": "fontFamily", "comment": "Sole typeface — all text in the TUI" }
    },
    "fontSize": {
      "xs":   { "value": "10px", "$type": "dimension", "comment": "Badge labels, structural annotations" },
      "sm":   { "value": "11px", "$type": "dimension", "comment": "Panel headers, keybinding labels, column headers" },
      "base": { "value": "12px", "$type": "dimension", "comment": "Secondary text, legend rows" },
      "md":   { "value": "13px", "$type": "dimension", "comment": "Body text — minimum for readable content" },
      "lg":   { "value": "14px", "$type": "dimension", "comment": "Brand wordmark (OCCAM)" },
      "xl":   { "value": "18px", "$type": "dimension", "comment": "Large metric values (SF score in lineage)" }
    },
    "fontWeight": {
      "regular": { "value": "400", "$type": "fontWeight" },
      "semibold": { "value": "600", "$type": "fontWeight" },
      "bold":     { "value": "700", "$type": "fontWeight", "comment": "WITNESS verdict, OCCAM brand, metric values" }
    }
  },

  "spacing": {
    "0":  { "value": "0px",  "$type": "dimension" },
    "1":  { "value": "2px",  "$type": "dimension" },
    "2":  { "value": "4px",  "$type": "dimension" },
    "3":  { "value": "6px",  "$type": "dimension" },
    "4":  { "value": "8px",  "$type": "dimension" },
    "5":  { "value": "10px", "$type": "dimension" },
    "6":  { "value": "12px", "$type": "dimension" },
    "7":  { "value": "14px", "$type": "dimension" },
    "8":  { "value": "16px", "$type": "dimension" },
    "10": { "value": "20px", "$type": "dimension" }
  },

  "layout": {
    "panel": {
      "lineage":  { "value": "210px", "$type": "dimension", "comment": "Left lineage tree width" },
      "right":    { "value": "228px", "$type": "dimension", "comment": "Right column width (DAG + metrics + lessons)" },
      "header":   { "value": "48px",  "$type": "dimension" },
      "compare":  { "value": "36px",  "$type": "dimension" },
      "diagnosis":{ "value": "88px",  "$type": "dimension" },
      "metrics":  { "value": "40px",  "$type": "dimension" },
      "keys":     { "value": "30px",  "$type": "dimension" }
    },
    "ablation": {
      "col": {
        "role":        { "value": "128px", "$type": "dimension" },
        "just":        { "value": "100px", "$type": "dimension" },
        "influence":   { "value": "120px", "$type": "dimension" },
        "ci":          { "value": "110px", "$type": "dimension" },
        "cost":        { "value": "52px",  "$type": "dimension" },
        "divergence":  { "value": "96px",  "$type": "dimension" },
        "verdict":     { "value": "136px", "$type": "dimension" }
      }
    }
  },

  "animation": {
    "pulse": { "value": "2s infinite", "$type": "duration", "comment": "● LIVE badge dot" },
    "blink": { "value": "1s step-end infinite", "$type": "duration", "comment": "Streaming cursor ▌" }
  },

  "char": {
    "cursor":    { "value": "▌", "$type": "string", "comment": "Streaming / pending cursor" },
    "pass":      { "value": "✓", "$type": "string" },
    "fail":      { "value": "✗", "$type": "string" },
    "bullet":    { "value": "●", "$type": "string" },
    "spark":     { "value": "▁▂▃▄▅▆▇█", "$type": "string", "comment": "Sparkline character set, index 0–7" },
    "barFull":   { "value": "▓", "$type": "string", "comment": "Filled segment of influence / progress bar" },
    "barEmpty":  { "value": "░", "$type": "string", "comment": "Empty segment" },
    "divFull":   { "value": "█", "$type": "string", "comment": "Filled segment of divergence bar" }
  }
}
