{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://occam.local/schemas/state.schema.json",
  "title": "Occam run state",
  "description": "The latest snapshot derived purely from an Occam event stream.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "last_seq",
    "run_name",
    "memory_ns",
    "lessons_loaded",
    "lessons",
    "task",
    "config",
    "generations",
    "current_generation",
    "best_generation",
    "completed",
    "summary",
    "diagnoses",
    "mutations",
    "logs"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "last_seq": {"type": "integer", "minimum": -1},
    "run_name": {"type": "string"},
    "memory_ns": {"type": "string"},
    "lessons_loaded": {"type": "array", "items": {"$ref": "#/$defs/lesson"}},
    "lessons": {"type": "array", "items": {"$ref": "#/$defs/lesson"}},
    "task": {"type": ["object", "null"]},
    "config": {"type": "object"},
    "generations": {
      "type": "object",
      "patternProperties": {"^g[0-9]{3,}$": {"$ref": "#/$defs/generation"}},
      "additionalProperties": false
    },
    "current_generation": {"type": ["integer", "null"], "minimum": 0},
    "best_generation": {"type": ["integer", "null"], "minimum": 0},
    "completed": {"type": "boolean"},
    "summary": {"type": "object"},
    "diagnoses": {"type": "array", "items": {"type": "object"}},
    "mutations": {"type": "array", "items": {"type": "object"}},
    "logs": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "text", "tool", "evidence", "born", "status"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "enum": ["tool_note", "domain_rule"]},
        "text": {"type": "string", "minLength": 1},
        "tool": {"type": ["string", "null"]},
        "evidence": {"type": "object"},
        "born": {"type": "object"},
        "status": {"type": "string", "enum": ["active", "retired"]}
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "justification", "model", "system_prompt", "tools", "inputs", "output_key"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "description": "Simple role identifier. Later roles reference this exact id in inputs; they do not reference output_key values."},
        "name": {"type": "string", "minLength": 1},
        "justification": {
          "type": "string",
          "enum": ["parallel", "context_isolation", "verification", "ensemble", "control", "unspecified"]
        },
        "model": {"type": "string", "minLength": 1},
        "system_prompt": {"type": "string"},
        "tools": {"type": "array", "items": {"type": "string"}},
        "inputs": {"type": "array", "description": "Dependency tokens: exactly \"task\" or an earlier declared role.id; never a role name, output_key, or invented descriptive alias.", "items": {"type": "string"}},
        "output_key": {"type": "string", "minLength": 1, "description": "Key under which this role output is stored for context rendering; it is not a valid inputs token."},
        "memory": {"type": "string", "enum": ["none", "scratchpad", "summary"], "default": "none"},
        "max_turns": {"type": "integer", "minimum": 1, "default": 6}
      }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "parent_id", "roles", "final_role"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "parent_id": {"type": ["string", "null"]},
        "roles": {"type": "array", "description": "Declare roles in topological order so each non-task inputs token names an earlier role.id.", "items": {"$ref": "#/$defs/role"}},
        "final_role": {"type": "string", "minLength": 1},
        "control": {"type": "string", "enum": ["llm", "deterministic"], "default": "deterministic"},
        "notes": {"type": "string", "default": ""}
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation", "architecture", "executions", "ablation", "baseline", "metrics", "reliability", "diagnosis", "mutation", "revert", "reverted"],
      "properties": {
        "generation": {"type": "integer", "minimum": 0},
        "architecture": {"oneOf": [{"$ref": "#/$defs/architecture"}, {"type": "null"}]},
        "executions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "ablation": {"type": ["object", "null"]},
        "baseline": {"type": ["object", "null"]},
        "metrics": {"oneOf": [{"$ref": "#/$defs/metricsSnapshot"}, {"type": "null"}]},
        "reliability": {"type": ["object", "null"]},
        "diagnosis": {"type": ["object", "null"]},
        "mutation": {"type": ["object", "null"]},
        "revert": {"type": ["object", "null"]},
        "reverted": {"type": "boolean"}
      }
    },
    "confidenceInterval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lo", "hi"],
      "properties": {
        "lo": {"type": "number"},
        "hi": {"type": "number"}
      }
    },
    "metricsSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation",
        "pass_rate",
        "ci",
        "cost_usd",
        "latency_s_mean",
        "latency_s_p50",
        "latency_s_p90",
        "tokens",
        "tool_calls_per_case",
        "reliability",
        "speed",
        "structural_fidelity",
        "vs_baseline"
      ],
      "properties": {
        "generation": {"type": "integer", "minimum": 0},
        "pass_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "ci": {"$ref": "#/$defs/confidenceInterval"},
        "cost_usd": {"type": "number", "minimum": 0},
        "latency_s_mean": {"type": "number", "minimum": 0},
        "latency_s_p50": {"type": "number", "minimum": 0},
        "latency_s_p90": {"type": "number", "minimum": 0},
        "tokens": {"type": "integer", "minimum": 0},
        "tool_calls_per_case": {"type": "number", "minimum": 0},
        "reliability": {"type": "number", "minimum": 0, "maximum": 1},
        "reliability_pass3": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "speed": {"type": "number", "minimum": 0},
        "structural_fidelity": {"type": "number", "minimum": 0, "maximum": 1},
        "vs_baseline": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pass_delta", "cost_ratio"],
          "properties": {
            "pass_delta": {"type": "number", "minimum": -1, "maximum": 1},
            "cost_ratio": {"type": "number", "minimum": 0}
          }
        }
      }
    }
  }
}
