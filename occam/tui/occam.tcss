/* Occam WP-09 stylesheet.
 *
 * Values are translated from design/tokens.css. Textual has no CSS custom
 * properties, so the names below are kept together as the single palette
 * boundary. The screen uses rules and dividers instead of rounded cards: the
 * table is the visual hero and the side rails stay compact.
 */
$bg-base: #0c0c0c;
$bg-panel: #111111;
$bg-selected: #1a1a1a;
$border: #272727;
$border-hi: #3c3c3c;
$wire: #383838;
$text-bright: #ebebeb;
$text: #cacaca;
$text-muted: #8c8c8c;
$green: #3fb950;
$green-bg: #0d2018;
$red: #f85149;
$red-bg: #2d0e0e;
$red-dim: #581414;
$amber: #d29922;
$amber-hi: #fbbf24;
$amber-bg: #231908;
$cyan: #58a6ff;
$cyan-bg: #0d1e2d;
$purple: #bc8cff;

Screen {
    background: $bg-base;
    color: $text;
    layout: vertical;
}

#header {
    height: 2;
    padding: 0 1;
    background: $bg-panel;
    border-bottom: solid $border;
}

#body {
    height: 1fr;
    layout: horizontal;
}

#col-left {
    width: 23;
    min-width: 20;
    border-right: solid $border;
    background: $bg-panel;
}

#col-centre {
    width: 1fr;
    min-width: 70;
    background: $bg-base;
}

#col-right {
    width: 29;
    min-width: 25;
    border-left: solid $border;
    background: $bg-panel;
}

.view-panel {
    background: $bg-base;
    color: $text;
    border: none;
    border-bottom: solid $border;
    padding: 0 1;
    scrollbar-size: 1 1;
}

.view-panel:focus {
    background: $bg-selected;
    border-bottom: solid $border-hi;
}

Tree.view-panel {
    background: $bg-panel;
}

#lineage {
    height: 1fr;
    min-height: 8;
    padding: 0 1;
}

#structural {
    height: 6;
    min-height: 5;
    background: $bg-panel;
    border-bottom: none;
}

#ablation {
    height: 20;
    min-height: 15;
    max-height: 24;
    padding: 0 1;
}

#ablation-table {
    height: auto;
    min-height: 5;
    max-height: 11;
    width: 1fr;
    background: $bg-base;
    color: $text;
    border: none;
    scrollbar-size: 1 1;
}

#ablation-table > .datatable--header {
    color: $text-muted;
    background: $bg-panel;
    text-style: bold;
}

#ablation-callout {
    height: 2;
    min-height: 1;
    padding: 0 1;
    background: $red-bg;
    color: $red;
}

#ablation-progress-label {
    height: 1;
    color: $amber;
    padding: 0 1;
}

#ablation-progress {
    height: 1;
    padding: 0 1;
    background: $bg-base;
    color: $cyan;
}

#ablation-footer {
    height: 2;
    min-height: 1;
    color: $text-muted;
    padding: 0 1;
}

#cases {
    height: 7;
    min-height: 5;
    max-height: 9;
    background: $bg-base;
}

#evidence {
    height: 1fr;
    min-height: 7;
    background: $bg-base;
}

#cases-grid {
    height: 2;
    color: $green;
    padding: 0 1;
}

#cases-detail {
    height: 2;
    color: $text;
    padding: 0 1;
}

#architecture {
    height: 1fr;
    min-height: 10;
    background: $bg-panel;
}

#generation-metrics {
    height: 12;
    min-height: 9;
    background: $bg-panel;
}

#lessons {
    height: 1fr;
    min-height: 12;
    background: $bg-panel;
    overflow-y: auto;
}

#baseline {
    height: 7;
    min-height: 4;
    background: $bg-panel;
}

#compare {
    height: 3;
    min-height: 2;
    background: $bg-panel;
    border-top: solid $border;
    border-bottom: solid $border;
    padding: 0 1;
}

#diagnosis {
    height: 6;
    min-height: 4;
    background: $bg-base;
    color: $text;
    border-bottom: solid $border;
    padding: 0 1;
}

#metrics {
    height: 4;
    min-height: 3;
    background: $bg-panel;
    border-bottom: solid $border;
    padding: 0 1;
}

#footer {
    height: 2;
    min-height: 1;
    background: $bg-panel;
    color: $text-muted;
    padding: 0 1;
}

HelpScreen {
    align: center middle;
    background: $bg-base 92%;
}

#help-body {
    width: 56;
    height: auto;
    padding: 1 2;
    background: $bg-panel;
    color: $text;
    border: solid $cyan;
}

CaseInspector {
    align: center middle;
    background: $bg-base 88%;
}

#inspector-body {
    width: 82;
    max-width: 92%;
    height: 32;
    max-height: 86%;
    overflow-y: auto;
    padding: 1 2;
    background: $bg-panel;
    color: $text;
    border: solid $amber;
}
