# Copy this file to .env for live LLM calls; Occam reads the project-root .env
# without changing the process environment. Explicitly exported variables win.
# Never commit credentials.
TENSORMUX_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: enables WP-15 tracing when that work package is implemented.
NEATLOGS_API_KEY=
